<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenedor-principal">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="CU2 · Reservar y Confirmar Entrada" styleClass="titulo-seccion"/>
    <Label text="ID del Evento (ej. ev-1):"/>
    <TextField fx:id="txtEventoId" promptText="Ingrese el ID del evento" text="ev-1"/>

    <Label text="ID del Estudiante (ej. est-1):"/>
    <TextField fx:id="txtEstudianteId" promptText="Ingrese el ID del estudiante"/>
    <Button text="Solicitar Reserva" onAction="#onSolicitar" styleClass="boton-primario"/>

    <Label text="Código de Reserva:"/>
    <TextField fx:id="txtCodigoReserva" promptText="Ingrese el código para confirmar"/>
    <Button text="Confirmar Reserva" onAction="#onConfirmar" styleClass="boton-primario"/>

    <Label fx:id="etiquetaMensaje" text="Ingrese los datos para solicitar o confirmar su reserva." styleClass="mensaje-resultado"/>
</VBox>
