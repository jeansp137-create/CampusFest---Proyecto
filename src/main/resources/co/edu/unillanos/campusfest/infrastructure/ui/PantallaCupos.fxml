<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.unillanos.campusfest.infrastructure.ui.PantallaCuposController"
      styleClass="contenedor-principal">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="CU1 · Consultar Cupos Disponibles" styleClass="titulo-seccion"/>
    <Label text="ID del Evento (ej. ev-1):"/>
    <TextField fx:id="txtEventoId" promptText="Ingrese el ID del evento" text="ev-1"/>
    <Button text="Consultar Cupos" onAction="#onConsultar" styleClass="boton-primario"/>
    <Label fx:id="lblResultado" text="Ingrese un evento y presione Consultar." styleClass="mensaje-resultado"/>
</VBox>
