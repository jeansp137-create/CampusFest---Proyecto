<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.unillanos.campusfest.infrastructure.ui.PantallaIngresoController"
      styleClass="contenedor-principal">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="CU4 · Registrar Ingreso con QR" styleClass="titulo-seccion"/>
    <Label text="ID del Evento (ej. ev-1):"/>
    <TextField fx:id="txtEventoId" promptText="Ingrese el ID del evento" text="ev-1"/>
    <Label text="Código QR de la Reserva:"/>
    <TextField fx:id="txtCodigoQr" promptText="Escanee o ingrese el código de la reserva"/>
    <Button text="Registrar Ingreso" onAction="#onRegistrarIngreso" styleClass="boton-primario"/>
    <Label fx:id="lblResultado" text="Ingrese el evento y el código QR." styleClass="mensaje-resultado"/>
</VBox>
