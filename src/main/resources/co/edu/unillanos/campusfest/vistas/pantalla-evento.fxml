<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenedor-principal">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="CU3 · Editar Evento" styleClass="titulo-seccion"/>

    <Label text="ID del Evento (ej. ev-1):"/>
    <HBox spacing="10.0">
        <TextField fx:id="txtEventoId" promptText="ID del evento" text="ev-1"/>
        <Button text="Cargar Datos" onAction="#onObtener" styleClass="boton-secundario"/>
    </HBox>

    <Label text="Nombre del Evento:"/>
    <TextField fx:id="txtNombre" promptText="Nombre del evento"/>

    <Label text="Fecha y Hora (yyyy-MM-dd HH:mm):"/>
    <TextField fx:id="txtFecha" promptText="Ej: 2026-11-28 19:00"/>

    <Label text="Lugar:"/>
    <TextField fx:id="txtLugar" promptText="Lugar del evento"/>

    <Label text="Nuevo Aforo:"/>
    <TextField fx:id="txtAforo" promptText="Aforo total"/>

    <Button text="Guardar Cambios" onAction="#onEditar" styleClass="boton-primario"/>

    <Label fx:id="lblResultado" text="Cargue un evento para editar sus datos." styleClass="mensaje-resultado"/>
    <Label fx:id="etiquetaMensaje" text="" styleClass="mensaje-resultado" visible="false" managed="false"/>
</VBox>
